<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ SafePath Mobile"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSafetyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_safe"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="SAFE"
            android:textColor="#16A34A"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Mobile Computing Indicators Dock -->
    <LinearLayout
        android:id="@+id/indicatorsDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F8FAFC"
        android:paddingVertical="6dp"
        android:paddingHorizontal="10dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvNetworkState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="📶 WiFi"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvGpsAccuracy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="🎯 ±3.5m"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="⚡ 14ms"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋 100%"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Prominent Segmented Role Switcher: Student Panel vs Admin Panel -->
    <LinearLayout
        android:id="@+id/roleTabBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:background="#F1F5F9"
        android:padding="3dp">

        <Button
            android:id="@+id/tabStudentPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📱 STUDENT PANEL"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            app:cornerRadius="6dp"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/tabAdminPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🛡️ ADMIN PANEL"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:backgroundTint="#E2E8F0"
            app:cornerRadius="6dp"
            android:layout_marginStart="3dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- ==================== 1. STUDENT PANEL VIEW ==================== -->
    <LinearLayout
        android:id="@+id/layoutStudentPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Student Switcher Horizontal Scroll (Only Daniel, Johan, Jie, Yu, Siling) -->
        <HorizontalScrollView
            android:id="@+id/studentScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="#FFFFFF"
            android:paddingVertical="5dp"
            android:paddingHorizontal="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipDaniel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🧑 Daniel"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2563EB"
                    android:layout_marginEnd="6dp"
                    app:strokeColor="#2563EB"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/chipJohan"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🧑 Johan"
                    android:textSize="11sp"
                    android:textColor="#475569"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="6dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/chipJie"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🧑 Jie"
                    android:textSize="11sp"
                    android:textColor="#475569"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="6dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/chipYuCheng"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🧑 Yu"
                    android:textSize="11sp"
                    android:textColor="#475569"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="6dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/chipSiling"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🧑 Siling"
                    android:textSize="11sp"
                    android:textColor="#475569"
                    android:backgroundTint="#FFFFFF"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />

        <!-- Emergency Warning Alert Banner (Appears on hazard detection) -->
        <LinearLayout
            android:id="@+id/layoutEmergencyBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#DC2626"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEmergencyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 DANGER: IN HAZARD ZONE"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmergencyDirectives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Evacuate immediately toward North Quad Assembly Field."
                android:textColor="#FEE2E2"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Student Leaflet Map WebView -->
        <WebView
            android:id="@+id/mapWebView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />

        <!-- Bottom Student Evacuation Control Card -->
        <LinearLayout
            android:id="@+id/bottomControlCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingTop="12dp"
            android:paddingHorizontal="14dp"
            android:paddingBottom="24dp">

            <!-- Evacuation Destination & Countdown -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvSafeRouteInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟢 Campus Status: All Clear (Safe Zone)"
                    android:textColor="#16A34A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♿ Ramps"
                    android:textColor="#475569"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Evacuation Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMoveToSafeZone"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="🏃 Move to Safe Zone"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D97706"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/btnMoveAllToSafeZone"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="👥 Move All"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2563EB"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- ==================== 2. ADMIN PANEL VIEW ==================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutAdminPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:background="#F8FAFC"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Admin EOC Role Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/banner_admin_light"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚨 CAMPUS ADMIN OPERATIONS &amp; DISPATCH"
                    android:textColor="#1E40AF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap anywhere on map or drag 🎯 to pin epicenter and broadcast live alerts."
                    android:textColor="#1E3A8A"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Quick Emergency Scenarios -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ QUICK SCENARIOS"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnScenarioChem"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="☣️ Spill"
                    android:textSize="10sp"
                    android:textColor="#0F172A"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="3dp"
                    app:strokeColor="#CBD5E1"
                    app:cornerRadius="6dp" />

                <Button
                    android:id="@+id/btnScenarioWildfire"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="🔥 Fire"
                    android:textSize="10sp"
                    android:textColor="#0F172A"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="3dp"
                    app:strokeColor="#CBD5E1"
                    app:cornerRadius="6dp" />

                <Button
                    android:id="@+id/btnScenarioQuake"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="🏚️ Quake"
                    android:textSize="10sp"
                    android:textColor="#0F172A"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="3dp"
                    app:strokeColor="#CBD5E1"
                    app:cornerRadius="6dp" />

                <Button
                    android:id="@+id/btnScenarioFlood"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="🌧️ Flood"
                    android:textSize="10sp"
                    android:textColor="#0F172A"
                    android:backgroundTint="#FFFFFF"
                    app:strokeColor="#CBD5E1"
                    app:cornerRadius="6dp" />
            </LinearLayout>

            <!-- Map Pinning Hint Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/banner_hazard_pin_light"
                android:paddingHorizontal="10dp"
                android:paddingVertical="7dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvAdminCenterGps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 Center: 33.8800, -117.8860"
                    android:textColor="#991B1B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP MAP TO PIN 🎯"
                    android:textColor="#DC2626"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Admin Leaflet Map with Epicenter Pinning -->
            <WebView
                android:id="@+id/adminMapWebView"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginBottom="12dp" />

            <!-- Dispatch Controls Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_bordered"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EMERGENCY CATEGORY (12 TYPES)"
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerAdminCategory"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/input_field_light"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SEVERITY LEVEL"
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerAdminSeverity"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/input_field_light"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvAdminRadiusLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GEOFENCE RADIUS: 200 METERS"
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekBarAdminRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="600"
                    android:min="50"
                    android:progress="200"
                    android:thumbTint="#DC2626"
                    android:progressTint="#DC2626"
                    android:layout_marginVertical="6dp" />

                <EditText
                    android:id="@+id/etAdminInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Evacuation instructions..."
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="12sp"
                    android:background="@drawable/input_field_light"
                    android:padding="10dp"
                    android:lines="2"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAdminBroadcast"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="2"
                        android:text="🚨 Broadcast Alert"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#DC2626"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnAdminClear"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="🗑️ Clear"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#64748B"
                        app:cornerRadius="8dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Connected Student Fleet Monitoring Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_bordered"
                android:padding="14dp"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="👥 CONNECTED STUDENT FLEET (5)"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAdminResetFleet"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="🔄 Reset Fleet"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#2563EB"
                        android:padding="0dp" />
                </LinearLayout>

                <!-- Student 1: Daniel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvFleetNameDaniel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🧑 Daniel"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvFleetStatusDaniel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 Safe (SZ1)"
                        android:textColor="#16A34A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E2E8F0" />

                <!-- Student 2: Johan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvFleetNameJohan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🧑 Johan"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvFleetStatusJohan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 Safe (SZ1)"
                        android:textColor="#16A34A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E2E8F0" />

                <!-- Student 3: Jie -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvFleetNameJie"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🧑 Jie"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvFleetStatusJie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 Safe (SZ2)"
                        android:textColor="#16A34A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E2E8F0" />

                <!-- Student 4: Yu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvFleetNameYu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🧑 Yu"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvFleetStatusYu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 Safe (SZ3)"
                        android:textColor="#16A34A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E2E8F0" />

                <!-- Student 5: Siling -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvFleetNameSiling"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🧑 Siling"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvFleetStatusSiling"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 Safe (SZ1)"
                        android:textColor="#16A34A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
